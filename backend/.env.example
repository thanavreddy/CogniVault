# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai
DATABASE_POOL_SIZE=20

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_base

# Redis (Caching & Celery)
REDIS_URL=redis://localhost:6379/0

# LLM Providers
OPENAI_API_KEY=your_openai_api_key
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=your_anthropic_api_key

# Authentication (Clerk)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_JWT_ISSUER=https://your-issuer.clerk.accounts.dev

# Observability
AGENTOPS_API_KEY=your_agentops_api_key
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enterprise-ai-backend

# Application
APP_ENV=development
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Document Processing
MAX_UPLOAD_SIZE_MB=50
SUPPORTED_FILE_TYPES=pdf,docx,txt,md
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Settings
MAX_CONTEXT_TOKENS=8000
HALLUCINATION_THRESHOLD=0.7

# Model Routing
MODEL_GPT4_MINI=gpt-4o-mini
MODEL_GPT4=gpt-4o
MODEL_CLAUDE=claude-3-7-sonnet-latest
